# Autonomous AI Work Manager - configuration
# Copy this file to .env and adjust values. API keys may be left empty on macOS
# (they are read from Keychain). On Windows/WSL, set SECRET_BACKEND=dotenv and
# fill the keys below. Never commit the .env file.

APP_HOST=127.0.0.1
APP_PORT=8765

# Leave empty to use the platform default
#   macOS / WSL: ~/.ai-work-manager/
#   Windows    : %LOCALAPPDATA%\AIWorkManager\
AIWM_DATA_DIR=

DEFAULT_LLM_PROVIDER=openai

MANAGER_MODEL=gpt-6
WORKER_MODEL=gpt-6
REVIEW_MODEL=gpt-6

# auto | keychain | dotenv
SECRET_BACKEND=auto

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

AUTO_START_MANAGER=true
ENABLE_DESKTOP_NOTIFICATIONS=true

# Optional tuning
LOG_LEVEL=INFO
MAX_REPLANNING_ATTEMPTS=3
MAX_WORKER_RETRIES=2
MAX_CONSECUTIVE_NO_PROGRESS=2
MANAGER_REEVALUATION_INTERVAL_MINUTES=30
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
